# Elastic Stack version
STACK_VERSION=8.17.0

# Passwords — change these before use
ELASTIC_PASSWORD=ElasticLab2024!
KIBANA_SYSTEM_PASSWORD=KibanaLab2024!

# Cluster / license
CLUSTER_NAME=elastic-security-lab
LICENSE=basic

# Ports
ES_PORT=9200
KIBANA_PORT=5601
