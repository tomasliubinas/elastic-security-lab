# Memory limits (bytes)
ES_MEM_LIMIT=2147483648
KB_MEM_LIMIT=1073741824
FS_MEM_LIMIT=1073741824

# Generated at runtime by setup.sh — do not edit manually
FLEET_SERVER_SERVICE_TOKEN=
FLEET_SERVER_POLICY_ID=

COMPOSE_PROJECT_NAME=elastic-security
